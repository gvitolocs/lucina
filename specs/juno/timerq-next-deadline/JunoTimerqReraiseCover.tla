------------------------- MODULE JunoTimerqReraiseCover -------------------------
(***************************************************************************)
(* Coverage witness for the re-raise branch of JunoTimerqNextDeadline       *)
(* (IrqSoft, "softP' = [softP EXCEPT ![c] = (S # due)]" with S # due).       *)
(* Nothing of the model is changed: this module only adds one state         *)
(* predicate. Its two configurations, JunoTimerqReraiseCoverWitness_*.cfg,  *)
(* have the constants of JunoTimerqNextDeadlineReraise_bound2.cfg and       *)
(* ..Reraise_delta2.cfg and MUST FAIL: the counterexample is a run of the   *)
(* unchanged design that takes the re-raise branch, so those two passing    *)
(* configurations are not vacuous for it.                                    *)
(*                                                                           *)
(* The module is NOT named JunoTimerqNextDeadline<...>: run.sh checks every *)
(* <Module>*.cfg of a directory against <Module>.tla, so a configuration    *)
(* whose name starts with JunoTimerqNextDeadline is run against the main    *)
(* module, where ReraiseNeverTaken is not defined.                          *)
(*                                                                           *)
(* Why the predicate is exactly "the re-raise branch was taken" (check it   *)
(* against the main module, Mutant = "none"):                                *)
(*  1. pc[c] becomes "soft" only in IrqSoft(c), ELSE branch (RUNNING free). *)
(*     That step sets softP[c] to FALSE when due = {}, and to (S # due)     *)
(*     otherwise.                                                            *)
(*  2. softP' differs from softP only in Enter(c) (needs pc[c] in           *)
(*     {"wfi", "run"}), IrqSoft(c) (needs pc[c] = "irq") and SoftEnd(c)     *)
(*     (leaves "soft" for "irq"). Arm, Cancel, Land, StopTick, StopRead,    *)
(*     StopWrite, IrqToRun, DevIrq, Advance and End leave softP unchanged,  *)
(*     and each of those three changes only the entry of its own CPU.       *)
(*  So while pc[c] = "soft", softP[c] is the value its IrqSoft step wrote:  *)
(*  pc[c] = "soft" /\ softP[c] holds in a state iff the last IrqSoft(c)     *)
(*  popped S with S # due, that is, left due timers and re-raised.          *)
(***************************************************************************)
EXTENDS JunoTimerqNextDeadline

ReraiseNeverTaken == \A c \in CPUS : pc[c] = "soft" => ~softP[c]
=============================================================================
