#!/usr/bin/env bash
# The fast local check, run in your worktree before a commit: only what the change touched, capped. docs/ci/SHIFT-LEFT.md.
# Usage: scripts/check-fast [--base REF] [--no-build] [--proofs [--mutants] [--all-proofs]] [--merge-gate]
#   --merge-gate                  must arrive as a bare argument (not --merge-gate=...): it asks the queue for the gate priority.
#   CHECK_FAST_FILTER_ONLY=<log>  run only the gate pass below over an existing check-fast log, and exit: how a test
#                                 reads a log without building, queueing or filling a disk.
#   CHECK_FAST_BIN=<path>         run that binary instead of the built release, and leave it where it is: the stub of
#                                 `lucina-ci check-fast` scripts/tests/check-fast-oos-test.sh drives end to end.
#   CHECK_FAST_LOG=<path>         write the raw unfiltered output there and keep it (a private temp file is deleted):
#                                 the same test reads what the pass folded.
#   LUCINA_CHECK_TMP=<dir>        where a run keeps its temp files (default <home>/scratch/tmp/check-fast); TMPDIR is set to it.
#   (the build queue)             <home>/.local/bin/bq, <home> being the passwd entry of this uid (never $HOME), which must print our
#                                 own usage or the check fails; a `bq` on PATH only when that file does not exist. No variable
#                                 names it. The launcher re-runs itself through it, class long (see the queue step below).
# Verus runs on GitHub; --proofs runs the affected proofs here.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
# The build queue. Every check-fast runs as ONE job of the queue's `long` class, so that several of them at once
# cannot stack up their steps outside the queue's slots (the host ran out of memory when 80 step scopes from concurrent runs stacked up). The
# launcher always re-runs itself through `bq run --class long`, and the job's own call (the same launcher, marked with the
# first argument --queued-by-bq, which only this launcher puts there and which is ignored unless bq really holds a slot for the run)
# does the work. No environment variable decides whether a
# run is queued: bq itself runs a nested call of the SAME class right there, with no ticket and no second slot, and queues a
# nested call of another class in its own pool (docs/ci/BQ.md, "Never nest"); it believes the BQ_SLOT / BQ_SLOT_PID mark only
# against its own slot record (tools/bq/src/main.rs, ancestor_slot_class), and a launcher that read the mark itself would be
# believing a caller's word on a weaker test. BQ_* names also reach the job unscrubbed (tools/bq/src/main.rs:1794-1799; the
# scrub list is :133), so keying on them would let any caller skip the queue.
# The queue is looked up in the home directory of the real uid from the passwd entry, never in $HOME (a caller's HOME decides
# nothing here): <home>/.local/bin/bq first, which must print our usage or the check FAILS (exit 2) and runs nothing; a `bq`
# on PATH only when that file does not exist, and only if it prints our usage (PATH holds the Google Cloud SDK's BigQuery
# `/usr/bin/bq` on GitHub's runners). A home that cannot be resolved is a refusal (exit 2), not "no queue here". Only a host with
# neither (GitHub's runners and any host without the queue binary) runs the check directly, and says so first, on stderr.
# The next line is the only one a test replaces (with a fixed home, in a copy of this script); nothing in the environment can.
qhome=$(
    export PATH=/usr/bin:/bin
    getent passwd "$(id -ru)" | cut -d: -f6
) || qhome=""
if [ -z "$qhome" ] || [ ! -d "$qhome" ]; then
    echo "check-fast: cannot resolve the home directory of this uid from the passwd entry; refusing, since the build queue is looked up there and nowhere else" >&2
    exit 2
fi
bq_is_ours() {
    local bq_usage
    [ -x "$1" ] || return 1
    bq_usage=$(timeout 5 "$1" </dev/null 2>&1 || true)
    # Our queue's usage offers `--class short|long|proof` and every option the call below passes; a queue that does not is
    # not one this launcher can call as written, and is not taken.
    case "$bq_usage" in
        *'--class short|long|proof'*) ;;
        *) return 1 ;;
    esac
    case "$bq_usage" in
        *'--max-wait'*) ;;
        *) return 1 ;;
    esac
    case "$bq_usage" in
        *'--priority'*) ;;
        *) return 1 ;;
    esac
    case "$bq_usage" in
        *'--keep-env'*) ;;
        *) return 1 ;;
    esac
    return 0
}
# 0: found, printed. 1: no bq of ours anywhere. 2: the bq in the home directory exists and is not ours.
bq_find() {
    local home_bq=$qhome/.local/bin/bq c
    if [ -e "$home_bq" ] || [ -L "$home_bq" ]; then
        if bq_is_ours "$home_bq"; then
            printf '%s\n' "$home_bq"
            return 0
        fi
        return 2
    fi
    c=$(command -v bq 2>/dev/null || true)
    if [ -n "$c" ] && bq_is_ours "$c"; then
        printf '%s\n' "$c"
        return 0
    fi
    return 1
}
# A typed --queued-by-bq is ignored unless bq really holds a slot for this run: the inner run believes it only as bq believes its
# own mark (tools/bq/src/main.rs, ancestor_slot_class): BQ_SLOT and BQ_SLOT_PID are set, BQ_SLOT_PID is a live ancestor of this
# shell, and the slot's meta file in the queue's state directory (<passwd home>/.cache/bq, never $HOME or BQ_DIR) names
# pid=<BQ_SLOT_PID> and a class bq knows. Otherwise the argument is dropped and the run queues like any other.
# Coupling: a nested check-fast is believed only if bq's state directory equals <passwd home>/.cache/bq. A bq run with BQ_DIR set,
# or with a $HOME different from the passwd home, writes its slot records elsewhere, so a genuine nested run re-queues and stops with
# exit 2 (queued twice, no slot record): it fails closed, never runs unqueued, and costs only availability.
bq_slot_is_real() {
    local spid=${BQ_SLOT_PID:-} p=$$ stat rest n=0 meta
    [ -n "${BQ_SLOT:-}" ] || return 1
    case "$BQ_SLOT" in */* | .*) return 1 ;; esac
    case "$spid" in '' | *[!0-9]*) return 1 ;; esac
    [ "$spid" -gt 1 ] || return 1
    [ -d "/proc/$spid" ] || return 1
    meta=$qhome/.cache/bq/$BQ_SLOT.meta
    [ -f "$meta" ] || return 1
    grep -qx "pid=$spid" "$meta" || return 1
    grep -qxE 'class=(gate|short|long|proof|node)' "$meta" || return 1
    while [ "$p" -gt 1 ] && [ "$n" -lt 64 ]; do
        [ "$p" = "$spid" ] && return 0
        stat=$(<"/proc/$p/stat") 2>/dev/null || return 1
        rest=${stat##*) } # after the command name, which may hold spaces and parentheses: "S ppid ..."
        rest=${rest#* }
        p=${rest%% *}
        case "$p" in '' | *[!0-9]*) return 1 ;; esac
        n=$((n + 1))
    done
    return 1
}
# The argument carries how many times this run has been through the queue (--queued-by-bq=N; a typed bare --queued-by-bq is 0). A
# run that still finds no real slot after being queued twice stops (exit 2) instead of going round again: a queue whose state
# directory is not the one looked up here would otherwise send the launcher through it for ever.
queued=0
depth=0
case "${1:-}" in
    --queued-by-bq=[0-9]*)
        depth=${1#--queued-by-bq=}
        shift
        case "$depth" in *[!0-9]*) depth=0 ;; esac
        if bq_slot_is_real; then queued=1; fi
        ;;
    --queued-by-bq)
        shift
        if bq_slot_is_real; then queued=1; fi
        ;;
esac
if [ "$queued" = 0 ] && [ "$depth" -ge 2 ]; then
    echo "check-fast: queued twice and bq holds no slot for this run (no $qhome/.cache/bq/<slot>.meta naming this run); refusing to go round again" >&2
    exit 2
fi
if [ "$queued" = 0 ] && [ -z "${CHECK_FAST_FILTER_ONLY:-}" ]; then
    bqrc=0
    bqbin=$(bq_find) || bqrc=$?
    if [ "$bqrc" -eq 2 ]; then
        echo "check-fast: $qhome/.local/bin/bq exists but is not our build queue (its usage does not offer --class short|long|proof, --max-wait, --priority and --keep-env); refusing to run without the queue" >&2
        exit 2
    fi
    if [ "$bqrc" -eq 0 ]; then
        prio=normal
        # 3600 s for a plain run. The merge gate runs under the outer limit of its pipeline gate (.lucina/pipeline.toml), which counts
        # the wait for the one gate slot, so it waits at most BQ_WAIT_ALLOWANCE_S (tools/ci/lucina-ci/src/budget.rs) and then fails at
        # once with bq's own message, instead of being killed by the clock halfway through its steps. A test ties the two.
        maxwait=3600
        for arg in "$@"; do
            if [ "$arg" = "--merge-gate" ]; then
                prio=gate
                maxwait=300
            fi
        done
        self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
        exec "$bqbin" run --class long --priority "$prio" --max-wait "$maxwait" --keep-env GIT_CONFIG_COUNT \
            --who "check-fast:$(basename "$root")" -- "$self" "--queued-by-bq=$((depth + 1))" "$@"
    fi
    # On stderr, so that the stdout of a run is still the check's own bytes; it is the first line the run prints.
    echo "check-fast: no bq on this host; running without the queue" >&2
fi
# A run is not small: the private copy of the binary, the raw log, and every temp file of lucina-ci and its children (reports,
# coverage, sweep scratch) go to TMPDIR. buildhost's /tmp is a quota'd tmpfs shared by every session, and on 2026-11-12 it filled and
# every check-fast failed. So the point is to leave /tmp: TMPDIR is set here rather than inherited, which means a caller's own
# TMPDIR is NOT kept; only an explicitly set LUCINA_CHECK_TMP steers this, and it does not touch anyone else's TMPDIR.
tmp_root=${LUCINA_CHECK_TMP:-$qhome/scratch/tmp/check-fast}
# The private copy of the tool this launcher execs is an O_EXCL mktemp file (mode 0700) in this directory, which the
# environment may choose. It must be a directory owned by this user and writable by no one else (a group or world write bit lets
# another process replace a file in it between the copy and the exec); anything else is a refusal with exit 2, with the command
# that fixes it. Made here with umask 022, a fresh one passes. It need not be under the home directory: the exclusive 0700 file
# is what is run, and CI and tests keep their temp folders elsewhere.
(
    umask 022
    mkdir -p "$tmp_root"
)
tmp_real=$(cd "$tmp_root" 2>/dev/null && pwd -P) || {
    echo "check-fast: $tmp_root is not a directory" >&2
    exit 2
}
read -r tmp_owner tmp_mode < <(stat -c '%u %a' "$tmp_real")
if [ "$tmp_owner" != "$(id -u)" ]; then
    echo "check-fast: $tmp_root is owned by uid $tmp_owner, not by this user; refusing to run a copy of the tool from there" >&2
    exit 2
fi
if [ $((8#$tmp_mode & 8#022)) -ne 0 ]; then
    echo "check-fast: $tmp_root is writable by group or others (mode $tmp_mode); refusing to run a copy of the tool from there. Fix: chmod go-w \"$tmp_real\"" >&2
    exit 2
fi
export TMPDIR=$tmp_root

# The one pass over the output of `lucina-ci check-fast`, which changes only how a full disk reads.
#
# A failing step is one block: the `FAIL <step>` line and the indented tail of its log under it. The pass holds a block until
# its tail ends (the first line that is not indented), because only the tail says why the step failed. A step that died on
# "No space left on device" or "Disk quota exceeded" (os error 28 and 122: the disk or the quota of a tmpfs was full while the
# step wrote its reports) says nothing about the tree under test, and on 2026-11-12 it cost the box a day of ghosts: 44
# leftover test folders of 1.1 GiB each filled the quota'd /tmp, and every run then failed on inventory, spec, roles and trust
# at once, which reads as four unrelated gate failures and is one full tmpfs.
#
# So those steps are not counted as failures of their own. Each prints one `oos` line in place of its `FAIL` (which step, and
# which folder), they are reported ONCE as `out of space in <dir>`, and the summary carries that one class instead of their
# number. The dir is the folder the message was writing (the parent of the path in it), the one folder the steps share when
# they name several, or TMPDIR when none names a path. Every other failure, its tail and the counts it adds are left exactly
# as they were; the exit code is the binary's own, so a full disk still fails the check, and the raw log keeps every tail this
# pass folded. GNU awk, for fflush() on every line it prints: a live run stays live, and a held tail is capped at 400 lines.
gate_pass() {
    awk -v tmpdir="${TMPDIR:-/tmp}" '
        function tail_punct(w) { sub(/[",;:()\[\]{}]+$/, "", w); return w }
        # The folder a path token names: its parent for a file, itself for a token that ends in a slash.
        function parent_of(w,   p, j) {
            p = w
            if (p ~ /\/$/) { sub(/\/+$/, "", p); return p }
            j = length(p)
            while (j > 0 && substr(p, j, 1) != "/") j--
            if (j <= 1) return "/"
            return substr(p, 1, j - 1)
        }
        function dir_in(line,   n, i, ws, w) {
            n = split(line, ws, /[ \t]+/)
            for (i = 1; i <= n; i++) {
                w = tail_punct(ws[i])
                if (substr(w, 1, 1) == "/" && length(w) > 1) return parent_of(w)
            }
            return tmpdir
        }
        function phrase(line) {
            if (match(line, /[Nn]o space left on device/)) return substr(line, RSTART, RLENGTH)
            if (match(line, /[Dd]isk quota exceeded/)) return substr(line, RSTART, RLENGTH)
            if (match(line, /[Qq]uota exceeded/)) return substr(line, RSTART, RLENGTH)
            return "out of space"
        }
        function scan(line) {
            if (line !~ /[Nn]o space left on device|[Dd]isk quota exceeded|[Qq]uota exceeded/) return
            space = 1
            if (bmsg == "") bmsg = phrase(line)
            if (bdir == "") bdir = dir_in(line)
        }
        function close_block(   d) {
            if (state != 1) return
            state = 0
            if (space) {
                k++
                names = names ((k > 1) ? ", " : "") bname
                d = (bdir == "") ? tmpdir : bdir
                if (!(d in seen)) { seen[d] = 1; ndir++; dlist[ndir] = d }
                if (cls == "") cls = bmsg
                printf "oos   %-28s out of space in %s (%s)\n", bname, d, bmsg
            } else {
                printf "%s", blk
            }
            fflush()
            blk = ""; nlines = 0; space = 0; bmsg = ""; bdir = ""
        }
        # One class names one folder: what a full disk complains about is usually the same tmpfs seen from a report path and
        # from a lock path, so the class is the folder they all live in. Only folders that share nothing print as a list.
        function class_dir(   i, ok, p, w) {
            if (ndir == 1) return dlist[1]
            w = dlist[1]
            while (length(w) > 1) {
                ok = 1
                for (i = 2; i <= ndir; i++) {
                    p = dlist[i]
                    if (p != w && substr(p, 1, length(w) + 1) != w "/") { ok = 0; break }
                }
                if (ok) return w
                p = w
                sub(/\/[^\/]*$/, "", p)
                if (p == w) break
                w = p
            }
            w = ""
            for (i = 1; i <= ndir; i++) w = w ((i > 1) ? ", " : "") dlist[i]
            return w
        }
        {
            if (state == 1) {
                if (substr($0, 1, 4) == "    ") {
                    blk = blk $0 "\n"; nlines++; scan($0)
                    if (nlines >= 400) close_block()   # a tail that never ends must not grow without bound
                    next
                }
                close_block()
            }
            if (substr($0, 1, 5) == "FAIL ") {
                state = 1; blk = $0 "\n"; nlines = 1; bname = $2; scan($0); next
            }
            if ($0 ~ /^check-fast: [0-9]+s, [0-9]+ failed, [0-9]+ skipped$/) {
                done = 1
                if (k == 0) { print; fflush(); next }
                line = $0; sub(/^check-fast: /, "", line); split(line, f, " ")
                secs = f[1]; sub(/s,$/, "", secs)
                other = f[2] - k; if (other < 0) other = 0
                printf "check-fast: out of space in %s: %s failed on a full disk (%s), which is ONE failure class and not %d gate failure%s. Nothing in those steps says anything about this tree: free the space, then re-run. `bq status` names the largest folders under /tmp and under ~/.cache; the raw log keeps the tails this pass folded.\n", class_dir(), names, cls, k, (k == 1 ? "" : "s")
                printf "check-fast: %ss, %d failed, %d skipped: out of space in %s (%s)\n", secs, other + 1, f[4], class_dir(), names
                fflush()
                next
            }
            print
            fflush()
        }
        END {
            close_block()
            if (k > 0 && !done) printf "check-fast: out of space in %s (%s failed on it), and the run ended without its summary line\n", class_dir(), names
        }
    '
}

# The gate pass alone, over a log of a finished run: what a full disk looks like to the reader, without a build or a queue.
if [ -n "${CHECK_FAST_FILTER_ONLY:-}" ]; then
    gate_pass <"$CHECK_FAST_FILTER_ONLY"
    exit 0
fi

# One Cargo target PER WORKTREE, all under one cache root. Cargo gives a workspace member the same artifact hash in every worktree, so a
# target shared by worktrees on different commits let one overwrite the others' rlibs and test binaries: a check could test code that
# was not in its worktree (seen twice on 2026-11-11). The first check in a new worktree compiles its dependencies (measured about 40 s
# for a one-crate change, 10 s warm). The root is swept to a size limit below (tools/ci/lucina-ci/src/sweep.rs).
cache_root=${LUCINA_CHECK_CACHE:-$qhome/.cache/lucina-check-target}
wt_id=wt-$(printf '%s' "$root" | sha1sum | cut -c1-10)
if [ -n "${CARGO_TARGET_DIR:-}" ] && [ "${CARGO_TARGET_DIR#"$cache_root"/}" = "$CARGO_TARGET_DIR" ] && [ "${LUCINA_CHECK_ALLOW_TARGET:-}" != 1 ]; then
    echo "check-fast: warning: CARGO_TARGET_DIR=$CARGO_TARGET_DIR (inherited) is outside $cache_root; a target shared with other worktrees can hold another commit's artifacts. lucina-ci also refuses a binary whose sources differ from this tree (set LUCINA_CHECK_ALLOW_TARGET=1 to silence this)." >&2
fi
# Root-mode sweep-target refuses a cache root without this marker file (a regular file `.lucina-check-target` holding `lucina-check-target`;
# Cargo's own CACHEDIR.TAG is left alone), so a LUCINA_CHECK_CACHE pointed at another cache cannot get its targets swept. Written when
# the cache root is created, and once on the default root, which is compared by resolved path.
# marker-begin
default_cache=${HOME:-/nonexistent}/.cache/lucina-check-target
if [ ! -d "$cache_root" ] || { [ -d "$default_cache" ] && [ "$(readlink -f "$cache_root")" = "$(readlink -f "$default_cache")" ]; }; then
    # A cache root that cannot be created is a warning, never a failed gate.
    mkdir -p "$cache_root" || echo "check-fast: warning: cannot create $cache_root" >&2
    marker=$cache_root/.lucina-check-target
    # A marker that is not a small regular file holding the expected line (a folder, a dangling link, a big file, other content) is
    # moved aside, so it cannot stay and make every sweep refuse this cache; the size is tested before anything is read. It goes under
    # the `.sweep-parked-` prefix, which the sweep never lists as a candidate and never deletes. The link check and the write are not
    # atomic; the only writer who can exploit that already owns the cache.
    if { [ -e "$marker" ] || [ -L "$marker" ]; } && ! { [ ! -L "$marker" ] && [ -f "$marker" ] && [ "$(stat -c %s "$marker")" -le 512 ] && [ "$(cat "$marker")" = "lucina-check-target" ]; }; then
        aside=$cache_root/.sweep-parked-$$-lucina-check-target-marker
        echo "check-fast: warning: $marker is not the cache marker; moved to $aside" >&2
        mv -- "$marker" "$aside" || true
    fi
    [ -e "$marker" ] || [ -L "$marker" ] || { printf 'lucina-check-target\n' > "$marker"; } 2> /dev/null || echo "check-fast: warning: cannot write $marker" >&2
fi
# marker-end
# The lines above between marker-begin and marker-end are what scripts/tests/check-fast-marker-test.sh runs; the target-dir lines below
# are covered by scripts/tests/check-fast-cache-root-test.sh. A cache root or target dir that cannot be created is a warning here,
# never a failed gate: cargo then creates the folder itself or fails with its own message, as it did before the marker existed.
export CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-$cache_root/$wt_id}
mkdir -p "$CARGO_TARGET_DIR" || echo "check-fast: warning: cannot create $CARGO_TARGET_DIR; cargo will try to create it or say why not" >&2
touch "$CARGO_TARGET_DIR/.last-used" 2> /dev/null || true
# No incremental compilation: the caches rarely get reused and were nearly half the old shared target's size (40 of 89 GiB on 2026-11-11,
# when buildhost's disk ran short). A caller that sets CARGO_INCREMENTAL keeps its value.
export CARGO_INCREMENTAL=${CARGO_INCREMENTAL:-0}
export LUCINA_CI_CPU_QUOTA=${LUCINA_CI_CPU_QUOTA:-400%}
free=$(df --output=avail -BG "$qhome" | tail -1 | tr -dc 0-9)
floor=${LUCINA_CHECK_FREE_FLOOR_GIB:-20}
[ "$free" -ge "$floor" ] || {
    # What to clean first, named: the three largest folders directly under ~/.cache. du gets 20 s, because walking a few hundred
    # GiB can take longer than that and a refusal that hangs is worse than one that says nothing about sizes. Only on a refusal,
    # never on the way through. No -s with --max-depth: on GNU du -s IS --max-depth=0 and refuses to combine with it.
    cache_home=$qhome/.cache
    rc=0
    big=$(timeout 20 du -k --max-depth=1 "$cache_home" 2>/dev/null) || rc=$?
    if [ "$rc" -eq 124 ]; then
        note="du on $cache_home timed out after 20 s: the largest folders are not named."
    elif [ "$rc" -ne 0 ]; then
        note="du on $cache_home failed (exit $rc): the largest folders are not named."
    else
        # The line naming ~/.cache itself is the total, not a folder; awk takes the three first records and still reads to EOF
        # (head -3 would close the pipe early and pipefail would make this substitution fail).
        note=$(printf '%s\n' "$big" | awk -F'\t' -v root="$cache_home" '$1 ~ /^[0-9]+$/ && $2 != root' | sort -rn |
            awk -F'\t' -v root="$cache_home" 'NR <= 3 { printf "%s%s %.1f GiB", (NR > 1 ? ", " : ""), substr($2, length(root) + 2), $1 / 1048576 }') || note=""
        if [ -n "$note" ]; then
            note="The three largest folders under $cache_home: $note."
        else
            note="No folders to name under $cache_home."
        fi
    fi
    echo "check-fast: only ${free} GiB free on $qhome's disk, the floor is ${floor} GiB: refusing to build rather than fill it. ${note} Free space first (stale worktrees: wt prune; the check cache $cache_root; one target: lucina-ci sweep-target --single)." >&2
    exit 2
}
# The binary to run: the built release, or CHECK_FAST_BIN. scripts/tests/check-fast-oos-test.sh gives a stub of
# `lucina-ci check-fast`, so the gate pass is tested end to end without a build, a queue or a real disk.
[ -n "${CHECK_FAST_BIN:-}" ] || cargo build --quiet --release --locked --manifest-path "$root/tools/ci/lucina-ci/Cargo.toml"
# Run from a private copy, so a rebuild of release/lucina-ci under a running check cannot pull it out from under its own
# sub-steps ("Failed to find executable ... (deleted)", seen 2026-11-11). This is the rename-install of the
# tool, done where this repo can do it: nothing of ours ever writes a name another run reads. Cargo owns the one name it
# writes itself ($CARGO_TARGET_DIR/release/lucina-ci, one target per worktree above, which is the same source-id keying the
# design, and `lucina-ci` refuses to start a check whose binary and tree sources differ); what a run reads is
# copied to a fresh unique name that belongs to this run alone — nothing else ever reads it, so nothing else can see it half
# written — and lucina-ci makes a copy of its own in the directory of the run it is in (RunDir and self_copy in
# tools/ci/lucina-ci/src/main.rs), so the guarantee also holds for a check-fast started straight off the built binary, with
# this launcher not in the way. Two copies of 3 MiB, both removed on every exit: the trap below for this one, the guard in
# Rust for the run's own directory.
# CHECK_FAST_BIN is used where it is, and CHECK_FAST_LOG keeps the raw unfiltered output where the caller can read it:
# neither is deleted. Without them the run is what it always was.
bin=${CHECK_FAST_BIN:-}
private_bin=""
if [ -z "$bin" ]; then
    bin=$(mktemp "${TMPDIR:-/tmp}/lucina-ci.XXXXXX")
    private_bin=$bin
    cp "$CARGO_TARGET_DIR/release/lucina-ci" "$bin"
    chmod 700 "$bin"
fi
log=${CHECK_FAST_LOG:-}
private_log=""
if [ -z "$log" ]; then
    log=$(mktemp "${TMPDIR:-/tmp}/check-fast-log.XXXXXX")
    private_log=$log
fi
cleanup() {
    [ -z "$private_bin" ] || rm -f "$private_bin"
    [ -z "$private_log" ] || rm -f "$private_log"
}
trap cleanup EXIT
# A size cap on the whole cache: over the limit the least recently used worktree targets go whole (never this one, never one with a build running).
"$bin" sweep-target --dir "$cache_root" --keep "$CARGO_TARGET_DIR" --limit-gib "${LUCINA_CHECK_TARGET_LIMIT_GIB:-30}" || true
# A run that ends without its summary line (killed, cut off mid-step, a tool that exited early) is a failure even when the exit code
# was 0: the output streams through tee, and the last word is the summary line. Stdout only; stderr stays on stderr. The raw log
# keeps what the binary printed, unfiltered, and the pass that collapses a full disk (above) reads the live stream.
rc=0
{ "$bin" check-fast "$@" | tee "$log" | gate_pass; } || rc=$?
if [ "$rc" -ne 0 ]; then
    exit "$rc"
fi
if ! tail -n 1 "$log" | grep -Eq '^check-fast: ([0-9]+s, [0-9]+ failed, [0-9]+ skipped|nothing changed against .+)$'; then
    echo "check-fast: the run ended without its summary line (killed or cut off): refusing, it did not finish" >&2
    exit 1
fi
